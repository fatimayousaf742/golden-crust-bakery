# =============================================================
# Golden Crust - Root .gitignore
# Stack: React (Vite) frontend / Node+Express+pg backend /
#        Python RAG chatbot (ChromaDB + Groq)
# =============================================================

# ---- Secrets & Environment -----------------------------------
# NEVER commit files with credentials, API keys, or DB connection strings.
# The golden_crust PostgreSQL connection string and chatbot (Groq) API key
# live in .env files under golden-crust/backend/ and golden-crust/rag_chatbot/.
.env
.env.*
*.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
!.env.example
!.env.sample

# ---- Node.js / Vite (frontend) --------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
coverage/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Node.js backend (Express) --------------------------------
backend/node_modules/
backend/package-lock.json

# ---- Python (RAG chatbot) --------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.installed.cfg
*.egg
.python-version
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.tox/
.nox/

# ---- Vector DB / RAG data --------------------------------------
chroma_db/
chroma/
*.sqlite
*.sqlite3
*.db

# ---- Logs --------------------------------------------------------
logs/
*.log
vite_out.txt
vite_err.txt

# ---- System / OS files -------------------------------------------
.DS_Store
.DS_Store?*
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---- Editor / IDE -------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Misc ---------------------------------------------------------
*.tgz
*.tmp
.nyc_output/
